# ==============================================================================
# ENVIRONMENT SETTINGS - YAYASAN AGUNG MADANI / SIT MADANI (CPANEL PRODUCTION)
# ==============================================================================
# Di cPanel, salin file ini menjadi .env:
# cp .env.cpanel.example .env
# ==============================================================================

APP_NAME="Yayasan Agung Madani - SIT Madani"
APP_ENV=production
APP_KEY=base64:JIgIDfpwqGwKR3rLURj3+GXG+eO3W1Nva5VMacn2q28=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://sitmadani.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==============================================================================
# DATABASE CPANEL (MySQL / MariaDB)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=berandad_db_sitmadani
DB_USERNAME=berandad_admin_sitmadani
DB_PASSWORD=P4l3mb4ng!

# ==============================================================================
# SESSION, CACHE & STORAGE (RAMAH CPANEL)
# ==============================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ==============================================================================
# PENGATURAN EMAIL / SMTP WEBMAIL CPANEL
# ==============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.sitmadani.sch.id
MAIL_PORT=465
MAIL_USERNAME=info@sitmadani.sch.id
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@sitmadani.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
